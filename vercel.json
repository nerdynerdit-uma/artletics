{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; media-src 'self'; connect-src 'self'; frame-src https://player.vimeo.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://www.artletics.nl"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/workshops",
      "destination": "/workshops/voor-jeugd",
      "permanent": false
    },
    {
      "source": "/workshops/voor-scholen",
      "destination": "/workshops/voor-jeugd",
      "permanent": true
    },
    {
      "source": "/aanbod/kinderen-jongeren-ouders",
      "destination": "/aanbod",
      "permanent": true
    },
    {
      "source": "/aanbod/scholen-gemeenten-organisaties",
      "destination": "/aanbod",
      "permanent": true
    },
    {
      "source": "/info",
      "destination": "/galerij/eindfestival",
      "permanent": true
    },
    {
      "source": "/fotos-voorbereiding",
      "destination": "/galerij/fotos-voorbereiding",
      "permanent": true
    },
    {
      "source": "/portfolio-1",
      "destination": "/galerij",
      "permanent": true
    },
    {
      "source": "/portfolio-1/project-one-f5w4d-kybrb",
      "destination": "/galerij/introductiedag",
      "permanent": true
    },
    {
      "source": "/galerij/project-one-f5w4d-kybrb",
      "destination": "/galerij/introductiedag",
      "permanent": true
    },
    {
      "source": "/portfolio-1/week2",
      "destination": "/galerij/week-2",
      "permanent": true
    },
    {
      "source": "/galerij/week2",
      "destination": "/galerij/week-2",
